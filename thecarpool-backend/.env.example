# TheCarPool backend — environment variables.
#
# Copy to .env for local development. Nothing here is required to boot: the
# server starts with every integration missing and degrades gracefully, logging
# which features are switched off. See src/lib/config.ts.
#
# In production these are set on the Cloud Run service, NOT from a file. Use
# --update-env-vars (never --set-env-vars, which drops everything not listed).

# ── Core ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated web origins allowed for CORS and Socket.IO. '*' allows all.
# Empty in production means "allow nothing", which will block the web app.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Firebase ───────────────────────────────────────────────────────────────
# Optional. On Cloud Run, firebase-admin authenticates via Application Default
# Credentials (the runtime service account), so leave this unset there. Locally,
# point it at a service-account JSON or use `gcloud auth application-default login`.
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Seeds demo data when the database is empty. Off by default: it costs a
# Firestore read on every cold start, and a populated database never needs it.
# SEED_FIRESTORE=false

# ── Payments (Razorpay) ────────────────────────────────────────────────────
# Collecting fares. Without these, booking and wallet top-ups return 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX (paying drivers out). NOT available to individual merchants —
# leaving it unset makes the app say withdrawals are unavailable rather than
# offering a button that fails. Route is used instead, and needs no extra keys.
# RAZORPAYX_ACCOUNT_NUMBER=

# Currency for new wallets and orders. INR when unset. Changing this does NOT
# make the app multi-currency: Razorpay settles INR only.
# DEFAULT_CURRENCY=INR

# ── Google ─────────────────────────────────────────────────────────────────
# Places (location search) and Directions (stop ETAs). Both are billed per
# request; without it, place search falls back to the local postal_codes data
# and stop ETAs are simply omitted.
GOOGLE_MAPS_API_KEY=

# ── Scheduled sweeps ───────────────────────────────────────────────────────
# Shared secret Cloud Scheduler presents as X-Cron-Key to run settlement and
# reminder sweeps. Without it those endpoints accept admin users only — and
# nothing settles, so drivers are never paid.
CRON_SECRET=

# ── Optional integrations ──────────────────────────────────────────────────
# Caching. Absent, the in-process cache is used instead (per-instance, short
# lived), so place lookups cost more Google requests.
# REDIS_URL=redis://localhost:6379

# Error monitoring. Absent, errors fall back to the console.
# SENTRY_DSN=

# Transactional email.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Twilio — masked calls between rider and driver, and SMS/WhatsApp booking
# notifications. Push notifications work without any of this.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PROXY_SERVICE_SID=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# Where a deleted user's leftover wallet balance is swept, when they have no
# payout details on file. Set to the platform/owner uid.
# PLATFORM_OWNER_UID=

# ── Rate limiting ──────────────────────────────────────────────────────────
# Defaults to 200 requests per minute per IP.
# RATE_LIMIT_MAX=200
# RATE_LIMIT_WINDOW=1 minute
