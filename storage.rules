rules_version = '2';

// TheCarPool Firebase Storage security rules.
//
// Per-user assets (avatars, classified photos) live under users/{uid}/** and
// are readable/writable only by their owner. Uploads from the app use a signed
// URL minted by the backend, but these rules add defence-in-depth for any
// direct client access.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.role == 'ADMIN');
    }

    function withinSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Per-user KYC documents — owner only, images up to 10 MB.
    match /users/{uid}/kyc/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && withinSizeLimit()
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Any other per-user assets (avatars, classifieds) — owner only, images up to 10 MB.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && withinSizeLimit()
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
