# TheCarPool Mobile — Environment Variables
# Copy this file to .env and fill in the values.
# These are also configured per-profile in eas.json for EAS Build.

# Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:5000

# Google Sign-In Client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Google Maps API Key (also set in app.json for native Android builds)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
