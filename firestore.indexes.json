{
  "indexes": [
    {
      "_comment": "GET /api/bookings/mine \u2014 the rider's booking list, and the ONLY place a rider can read their boarding OTP. Without this index the query throws FAILED_PRECONDITION, the route 500s, and no driver can ever verify boarding (so every trip settles as a no-show at 5%).",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "rider_id",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "created_at",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "POST /api/rides/search \u2014 the candidate scan. Without this index no rider can find any ride at all.",
      "collectionGroup": "rides",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "departure_time",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "rides",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "settlement_due_at",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "disputed",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "escrow_status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "POST /api/rides/cleanup-expired \u2014 status IN [SCHEDULED, CREATED] plus a created_at range. Without it the sweep throws FAILED_PRECONDITION and every run 500s, so stale rides are never expired and keep appearing in search.",
      "collectionGroup": "rides",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "created_at",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "GET /api/bookings/requests/pending \u2014 ride_id IN + booking_status. Without it the driver cannot see any pending seat request at all.",
      "collectionGroup": "bookings",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "ride_id",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "booking_status",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
